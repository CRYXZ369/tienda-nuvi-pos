# Copia como config/backup.local.env. Nunca subas el archivo local a GitHub.
DB_NAME=tienda_nuvi
DB_USER=root
DB_PASSWORD=cambia_esta_contrasena
WEB_DIR=/var/www/html/Tienda
BACKUP_DIR=/var/backups/tienda_nuvi
LAPTOP_HOST=
LAPTOP_USER=usuario_respaldo
LAPTOP_DESTINATION=~/backups/nuvi_actual.tar.gz
# Opcional: endpoint seguro para recibir avisos de fallo (no se usa si queda vacío).
BACKUP_ALERT_WEBHOOK_URL=
# Base de datos desechable exclusiva para probar una restauración mensual.
# Debe terminar en _restore_test; nunca uses la base de producción.
RESTORE_TEST_DB=tienda_nuvi_restore_test
